# Copy to .env.local and adjust. Vite only exposes VITE_-prefixed vars to the client.

# Set to "false" once zorkinator/view (FastAPI) is running locally and you want
# real data instead of the built-in mock dataset.
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false. Run the backend with:
#   .venv/bin/uvicorn zorkinator.view.app:app --reload --port 8010
VITE_API_BASE_URL=http://localhost:8010
